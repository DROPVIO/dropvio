# Toutes les variables lues par le code (noms uniquement, aucune valeur).
# Copier vers .env.local et remplir. Ne jamais committer .env.local (ignoré par git : .env*).

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Côté serveur uniquement (webhooks, écritures de facturation) : ne jamais exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# --- IA ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Stripe (MODE TEST pour le développement : sk_test_… et whsec_… de test) ---
STRIPE_SECRET_KEY=
# En local : affiché par `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# (whsec_…, change à chaque session de stripe listen). En ligne : secret de l'endpoint du dashboard.
# Événements à activer sur l'endpoint : checkout.session.completed, customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted, invoice.paid, invoice.payment_failed
# (lib/stripe-webhook.ts, EVENEMENTS_STRIPE).
STRIPE_WEBHOOK_SECRET=

# Abonnements : un Price récurrent mensuel par plan (lib/stripe.ts). Expert n'a pas de Price fixe :
# son montant est calculé selon la configuration du mois (lib/expert-billing.ts).
# En test : créés par `npx tsx scripts/stripe-creer-prix-test.ts`, qui affiche les identifiants.
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=

# Formation : un Price one-time par offre (lib/stripe.ts). Créés aussi par le script ci-dessus.
STRIPE_PRICE_FORMATION_COURTE=
STRIPE_PRICE_FORMATION_LONGUE=
STRIPE_PRICE_FORMATION_BUNDLE=

# Optionnel : configuration du portail client réservée aux abonnés Expert, sans changement de
# plan (id bpc_...). Vide : le portail est fermé aux abonnés Expert et « Gérer » est masqué sur /quota.
STRIPE_PORTAL_CONFIGURATION_EXPERT=

# --- Shopify (app Partners, OAuth Admin API) ---
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Chiffrement des jetons d'accès Shopify en base (AES-256, lib/crypto.ts) : 32 octets en base64,
# à générer avec `openssl rand -base64 32`. Obligatoire pour connecter une boutique.
TOKEN_ENCRYPTION_KEY=

# --- AliExpress Open Platform (API Affiliate) ---
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=

# --- Tâches planifiées ---
# Secret attendu par les routes /api/cron/* (en-tête Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=

# --- Domaines ---
# Domaine racine des boutiques ({slug}.DOMAINE). Vide tant qu'aucun domaine n'est acheté :
# /boutiques/{slug} reste alors le seul chemin d'accès.
NEXT_PUBLIC_ROOT_DOMAIN=
# Optionnel : affiche l'ancien éditeur de templates dans le Site Builder (« true » pour activer).
NEXT_PUBLIC_SHOW_LEGACY_TEMPLATES=
